        "FULL_DATASET_FIGURES_V1/data/DRUGseq.h5",
        "FULL_DATASET_FIGURES_V1/data/DRUGseq_META.parquet",
        "FULL_DATASET_FIGURES_V1/COMMON_GENES.json"
      ],
      "outputs": [
        "FULL_DATASET_FIGURES_V1/results/DRUGseq*.csv*",
        "FULL_DATASET_FIGURES_V1/receipts/DRUGseq_ANALYZED.json"
      ]
    },
    {
