        "baicai/canonical_perturbation_data_v1/tahoe/data/gene_axis.parquet",
        "FULL_DATASET_FIGURES_V1/COMMON_GENES.json"
      ],
      "outputs": [
        "4MAN/TAHOE_DESCRIPTIVE_FULL_V2/results/Tahoe_REPEAT_SUMMARY.csv"
      ],
      "note": "All independent plate pairs are recalculated from freshly reconstructed physical-plate profiles."
    }
  ]
